#!/bin/sh
# Every commit here follows the commit-messages skill, including the ones
# that add it. Enabled by: git config core.hooksPath .githooks
# The private-name check runs here, not inside the skill's own script, so the
# skill does not carry this repository's denylist to everyone who installs it.
"$(dirname "$0")/../scripts/denylist-check.sh" "$1" || exit 1
exec "$(dirname "$0")/../commit-messages/scripts/commit-msg" "$@"
