#!/bin/sh
# Checks commitlint cannot express. Install from the root of the repository
# that gets the hook:
#   hooks=$(git rev-parse --git-path hooks)
#   cp <skill-dir>/scripts/commit-msg "$hooks/" && chmod +x "$hooks/commit-msg"
# Or, with pre-commit, add a commit-msg stage hook that runs this file.
set -eu
msg_file="$1"

# Git hands the hook the file before its own cleanup. With `commit -v` the file
# still holds the diff below the scissors line. A diff that quoted an
# attribution line or a long dash failed the commit, so the checks stop there.
# Comment lines stay in for the attribution and dash checks: `commit -m` keeps
# them in the commit. Only the subject skips them, because the editor template
# can put a comment above an empty first line.
cc=$(git config --get core.commentString 2>/dev/null || git config --get core.commentChar 2>/dev/null || true)
case "$cc" in ''|auto) cc='#' ;; esac
msg=$(awk -v cc="$cc" '
  $0 == cc " ------------------------ >8 ------------------------" { exit }
  { print }' "$msg_file")
subject=$(printf '%s\n' "$msg" | awk -v cc="$cc" '
  substr($0, 1, length(cc)) == cc { next }
  /[^[:space:]]/ { print; exit }')
fail=0
say() { echo "commit-msg: $1" >&2; fail=1; }

# Attribution lines outlive their accuracy and clutter git log.
# An indent or a leading emoji does not exempt a line, so normalise first.
norm=$(printf '%s\n' "$msg" | sed -E 's/^[^A-Za-z]*//')

# Two shapes: a trailer, and a credit sentence that names a tool or links one.
# A bare `generated by` is not enough: `Generated by protoc 28.1, so the diff
# is large.` is a fact about the change, not a credit.
# A tool name counts as a whole word, and a Markdown link counts as a credit.
# `gpt-tokenizer` is a library, not a credit; `GPT-5` is a model.
# `cursor` is left out: `the cursor walker` is code, not a credit.
trailer='^(co-authored-by|authored-by|assisted-by|generated-by|created-with|made-with|claude-session|claude-code)[[:space:]]*:'
credit='^(generated|created|written|made) (with|by|using) '
names='claude|copilot|chatgpt|gpt|codex|junie|gemini|aider'
if printf '%s\n' "$norm" | grep -qiE "$trailer|$credit(.*[^a-z])?($names)([^a-z-]|-[0-9]|$)|$credit.*\[[^]]*\]\("; then
  say "attribution line found - remove it"
fi

# A DCO project needs Signed-off-by. Set ALLOW_SIGNOFF=1 there.
if [ "${ALLOW_SIGNOFF:-0}" != 1 ] && printf '%s\n' "$norm" | grep -qiE '^signed-off-by'; then
  say "Signed-off-by found - set ALLOW_SIGNOFF=1 if this project uses DCO"
fi

# Hyphen only, everywhere.
if printf '%s\n' "$msg" | grep -q -e '—' -e '–'; then
  say "long dash found - use a hyphen"
fi

# A message git writes itself keeps git's shape, so the structure checks below
# skip it. The checks above still apply: a merge carries a credit line as
# easily as any other commit.
case "$subject" in
  "Merge branch "*|"Merge pull request "*|"Merge remote-tracking branch "*|"Merge tag "*|"Merge commit "*|'Revert "'*|"fixup! "*|"squash! "*|"amend! "*)
    exit "$fail" ;;
esac

# Structure only: a type, an optional scope, an optional `!`, a colon and a
# description. references/enforcement.md says why the type list is not here,
# and why this check repeats commitlint.
if ! printf '%s' "$subject" | grep -qE '^[a-z]+(\([a-z0-9._-]+\))?!?: .'; then
  say "no type: expected <type>[(scope)][!]: <description>"
fi

# A trailing period buys nothing and eats one of the 50 characters.
case "$subject" in
  *.) say "trailing period in the subject" ;;
esac

# Description starts lower case, after an optional ticket id.
desc=$(printf '%s' "$subject" | sed -E 's/^[a-z]+(\([a-z0-9._-]+\))?!?: *//; s/^[A-Z][A-Z0-9]+-[0-9]+ *//')
# `[[:upper:]]` and not `[A-Z]`: a range walks the locale's collation order.
# Under `en_US.UTF-8` almost every lower-case letter sorts inside `A` to `Z`,
# and the range rejected `run Hephaestus on the host` for a lower-case `r`.
# grep and not a case glob: dash matches a glob byte by byte, so `Éclair`
# passed there.
if printf '%s\n' "$desc" | grep -q '^[[:upper:]]'; then
  say "description starts upper case: $desc"
fi

# 50 is the target, 72 is the wall.
# `wc -m` and not `${#subject}`: dash, the `sh` of Debian and Ubuntu, counts
# bytes in every locale. `wc -m` counts characters under a UTF-8 locale, which
# a hook inherits from the shell, and falls back to bytes under `C`.
len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$len" -gt 72 ]; then
  say "subject is $len characters, over the 72 limit"
elif [ "$len" -gt 50 ]; then
  echo "commit-msg: subject is $len characters, target is 50" >&2
fi

exit "$fail"
