# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break. Trimming them changes the text.
trim_trailing_whitespace = false
# Prose is never wrapped here, so line length stays off for Markdown.
max_line_length = off

[*.py]
# PEP 8 indentation. Two spaces would mix indent widths inside a Python file
# on the first edit.
indent_size = 4

[Makefile]
indent_style = tab
